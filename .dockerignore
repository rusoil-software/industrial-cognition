#
# Keep the build context small and the images reproducible.
#
# The ONNX artifact is ~293 MB and is mounted from the `model-cache` PVC at
# /app/models (k8s/base/deployment-vision.yaml), so it must not be baked into an
# image: doing so would add minutes to every build and pin a model version into
# an image that is meant to be model-agnostic.

# Model artifacts and caches
src/owl/models/
*.onnx
*.onnx.data
*.engine
*.plan

# Local environments and tool state
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.scratch/

# Version control and CI
.git/
.gitignore
.githooks/

# Tests, docs and scripts do not belong in a runtime image
tests/
doc/
scripts/
*.md
msg-*.txt

# Editor and OS noise
.vscode/
.idea/
.DS_Store

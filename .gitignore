# Kubernetes: credentials are generated, never committed.
# `k8s/base/secrets.env.example` is the tracked template; `secrets.env` is created from it
# by install.ps1 / install.sh with random values and stays on the machine that made it.
# See doc/k8s.md §5.
k8s/overlays/*/secrets.env
k8s/base/secrets.env

# Kubernetes: rendered manifests and local tool state
k8s/**/*.rendered.yaml


# Kubernetes tests: scratch kustomization fixtures
tests/k8s/.scratch/

# Model weights downloaded at run time (benchmark, ultralytics CLIP): never committed.
# `YOLO_WEIGHTS_DIR` points the detector weights at a cache; ultralytics still drops its
# CLIP text encoder here, which is why the directory exists at all.
weights/
reports/*.json

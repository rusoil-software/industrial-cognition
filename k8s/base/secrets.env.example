# author : Konstantin Ustiuzhanin
# date   : 2026-Oct-4
# ==============================================================================
#
# Rendered by Kustomize `secretGenerator` into the Secret
# `industrial-cognition-secrets` (keys = variable names below).
#
#   !!! DEVELOPMENT DEFAULTS - NOT FOR PRODUCTION !!!
#
# These values exist so that a fresh clone renders and boots without a manual
# step. For any real installation, copy this file to the overlay
# (`k8s/overlays/<env>/secrets.env`), replace every value with a generated
# secret, and add a `secretGenerator` entry to that overlay's kustomization
# (see doc/k8s.md §5). The overlay copy is git-ignored.
#
# Generate strong values with:
#   openssl rand -base64 32
#
# Postgres
POSTGRES_USER=cogni
POSTGRES_PASSWORD=cogni-dev-password
POSTGRES_DB=cogni_db
# RabbitMQ
RABBITMQ_DEFAULT_USER=cogni
RABBITMQ_DEFAULT_PASS=cogni-dev-password
RABBITMQ_ERLANG_COOKIE=cogni-dev-erlang-cookie
# Full AMQP URL, consumed only by the opt-in KEDA ScaledObject
# (k8s/components/keda). KEDA's scaler needs one `host` value and Kubernetes
# cannot concatenate separate Secret keys, so the composed URL is stored here
# and must be rotated together with the user/password above.
RABBITMQ_URL=amqp://cogni:cogni-dev-password@rabbitmq:5672//
# Redis
REDIS_PASSWORD=cogni-dev-password
# MinIO
MINIO_ACCESS_KEY=cogni
MINIO_SECRET_KEY=cogni-dev-password
# Grafana (only used when the monitoring component is enabled)
GRAFANA_ADMIN_PASSWORD=cogni-dev-password

# Operator console access (doc/operator-console.md).
# AUTH_TOKEN is what the user types; JWT_SECRET signs the session cookie.
# Rotate both for any deployment that is not a throwaway dev cluster.
AUTH_TOKEN=cogni-dev-console-token
JWT_SECRET=cogni-dev-jwt-signing-key

# Dockerfile for the Celery Worker Container (vision worker)
# This image is optimized to run the heavy computation logic, consuming messages
# from RabbitMQ and writing results to MinIO/Redis.

FROM python:3.11-slim

WORKDIR /app

# Copy requirements files first
COPY requirements/vision.txt requirements/vision.txt

# Install dependencies
RUN pip install --no-cache-dir -r requirements/vision.txt

# Copy the entire source code structure
COPY src/ ./src/

# Expose the internal port if needed, but generally, workers listen on broker ports.
# We don't need to expose a port here as we communicate via the network, not HTTP.

# Entrypoint will be managed by the celery command run via docker-compose/K8s
CMD ["celery", "-A", "src.tasks.celery", "worker", "-l", "info"]